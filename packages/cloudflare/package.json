{
  "name": "@app-version/cloudflare",
  "version": "0.1.0",
  "description": "Cloudflare Pages and Workers skew protection: build adapters for @app-version/vite and the asset fallback handler.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./worker": "./dist/worker.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc && tsc -p test/edge",
    "test": "vitest run",
    "test:edge": "vitest run --config vitest.edge.config.ts",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "@app-version/vite": "workspace:^"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261108.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "@app-version/vite": "workspace:*"
  }
}
