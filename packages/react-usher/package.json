{
  "name": "@rndsqr/react-usher",
  "version": "0.1.0",
  "description": "React hooks for Usher update state and refresh blockers.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc",
    "test": "vitest run",
    "coverage": "vitest run --coverage --project browser && vitest run --project webkit"
  },
  "peerDependencies": {
    "@rndsqr/usher-core": "workspace:^",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@guidepup/virtual-screen-reader": "^0.33.0",
    "@rndsqr/usher-core": "workspace:*",
    "@rndsqr/usher-plugin": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  }
}
