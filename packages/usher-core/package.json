{
  "name": "@ericchernuka/usher-core",
  "version": "0.2.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericchernuka/usher.git",
    "directory": "packages/usher-core"
  },
  "description": "Keep running apps on the current build with version polling, update state, and update surfaces.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./testing": "./dist/testing.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
